.nav-container a {
    color: rgb(0, 0, 0); 
    text-decoration: none; 
    font-size: 16px; 
    padding: 5px 10px; 
}

.nav-container a:hover {
    background-color: #d4d0d0; 
}

.nav-logo {
    max-height: 50px; 
