    margin-right: 20px; 
    margin-left: -100px;
}

@media screen and (max-width: 768px) {
    .nav-container {
        flex-wrap: wrap;
        padding: 10px 5px;
    }
    .nav-logo {
        margin-right: 10px;
        margin-left: 0;
    }
}
